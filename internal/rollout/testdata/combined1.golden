# mode roll
# a new node runs Nomad 2.0.7
# group control: combined, size 1, zones ams and fra, drain 1h0m0s
# machine prod-control-0 (m-1) in ams runs Nomad 2.0.6, outdated
# leader prod-control-0
create node prod-control-1 (combined of control, ams)
wait until node prod-control-1 joins
wait until 12:01:30 UTC for the servers to be stable
mark node prod-control-0 ineligible
drain node prod-control-0 within 1h0m0s
wait until node prod-control-0 is drained
move the leadership from prod-control-0 to prod-control-1
wait until 12:03:00 UTC for the servers to be stable
remove prod-control-0 from the Raft configuration
stop node prod-control-0 (ID m-1)
force prod-control-0.global out of the gossip pool
delete node prod-control-0 (ID m-1)
wait until Nomad lists node prod-control-0 at 10.64.0.3 as down
purge node prod-control-0 at 10.64.0.3 from Nomad
done
