# mode roll
# a new node runs Nomad 2.0.7
# group workers: client, size 3, zones ams and fra, maxSurge 1, maxUnavailable 0, drain 1h0m0s
# machine prod-servers-0 (m-1) in ams runs Nomad 2.0.7
# machine prod-workers-0 (m-2) in ams runs Nomad 2.0.6, outdated
# machine prod-workers-1 (m-3) in fra runs Nomad 2.0.6, outdated
# machine prod-workers-2 (m-4) in ams runs Nomad 2.0.6, outdated
# leader prod-servers-0
create node prod-workers-3 (client of workers, ams)
wait until node prod-workers-3 joins
mark node prod-workers-0 ineligible
drain node prod-workers-0 within 1h0m0s
wait until node prod-workers-0 is drained
delete node prod-workers-0 (ID m-2)
create node prod-workers-0 (client of workers, fra)
wait until node prod-workers-0 joins
purge node prod-workers-0 at 10.64.0.4 from Nomad
mark node prod-workers-1 ineligible
drain node prod-workers-1 within 1h0m0s
wait until node prod-workers-1 is drained
delete node prod-workers-1 (ID m-3)
create node prod-workers-1 (client of workers, ams)
wait until node prod-workers-1 joins
purge node prod-workers-1 at 10.64.0.5 from Nomad
mark node prod-workers-2 ineligible
drain node prod-workers-2 within 1h0m0s
wait until node prod-workers-2 is drained
delete node prod-workers-2 (ID m-4)
wait until Nomad lists node prod-workers-2 at 10.64.0.6 as down
purge node prod-workers-2 at 10.64.0.6 from Nomad
done
